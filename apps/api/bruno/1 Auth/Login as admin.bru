meta {
  name: Login as admin
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation Login($email: String!, $password: String!) {
    login(email: $email, password: $password) {
      accessToken
      user {
        id
        email
        role
      }
    }
  }
}

body:graphql:vars {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  const token = res.body?.data?.login?.accessToken;
  if (token) bru.setVar("token", token);
}

tests {
  test("returns an ADMIN token", function () {
    expect(res.body.errors).to.be.undefined;
    expect(res.body.data.login.user.role).to.equal("ADMIN");
    expect(bru.getVar("token")).to.be.a("string");
  });
}
