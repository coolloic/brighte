meta {
  name: List leads without token (UNAUTHENTICATED)
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query Leads {
    leads {
      total
    }
  }
}

tests {
  test("no token is refused", function () {
    expect(res.body.errors[0].extensions.code).to.equal("UNAUTHENTICATED");
  });
}
