# The port must match POSTGRES_PORT in the root .env (default 5435).
DATABASE_URL=postgres://brighte:brighte@localhost:5435/brighte
# Ports live in the root .env (API_PORT, WEB_PORT). PORT here would override API_PORT.
# Browser origins allowed by CORS, comma-separated. Required when NODE_ENV=production;
# locally it defaults to http://localhost:${WEB_PORT}.
# WEB_ORIGIN=https://app.example.com
# Behind a load balancer or proxy: number of proxy hops (e.g. 1), so rate limits see the client IP.
# Leave unset when clients connect directly, or they can spoof their IP with X-Forwarded-For.
# TRUST_PROXY=1
# Log level: trace, debug, info (default), warn, error, fatal or silent. Logs are JSON lines,
# pretty-printed when running in a terminal outside production.
# LOG_LEVEL=info
# Requests per minute, per client IP and per operation.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
# Database connections per API instance (default 10). Keep instances x this under Postgres's max_connections.
# DB_POOL_MAX=10
# Close a database connection unused for this long, in ms (default 10000).
# DB_POOL_IDLE_MS=10000
# Postgres cancels a statement that runs longer than this (default 5000).
# DB_STATEMENT_TIMEOUT_MS=5000
# At least 32 characters. pnpm bootstrap fills in a random one; or generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Access token lifetime, and so the idle timeout: an active session renews its token (renewToken).
JWT_EXPIRES_IN=30m
# The longest a session can be renewed, in hours after signing in; then sign in again.
SESSION_MAX_HOURS=8
# Dev-only seed accounts (pnpm db:seed), at least 8 characters.
SEED_ADMIN_PASSWORD=admin-dev-password
SEED_USER_PASSWORD=user-dev-password
