{
  "name": "@brighte/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev --port ${WEB_PORT:-3001} \"$@\"' sh",
    "build": "next build",
    "start": "dotenv -e ../../.env -- sh -c 'next start --port ${WEB_PORT:-3001} \"$@\"' sh",
    "lint": "eslint",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "storybook": "dotenv -e ../../.env -- sh -c 'storybook dev --port ${STORYBOOK_PORT:-6006} \"$@\"' sh",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "lighthouse": "lhci collect && lhci assert && lhci upload"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
