{
  "name": "brighte",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap-env.mjs && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @brighte/web storybook",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @brighte/api db:migrate",
    "db:seed": "pnpm --filter @brighte/api db:seed",
    "lint:style": "turbo run lint:style",
    "typecheck": "turbo run typecheck",
    "test:e2e": "turbo run test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2"
  },
  "packageManager": "pnpm@12.6.0"
}
