# Local ports, shared by every app and tool. Copy to .env (gitignored) to change them;
# anything left unset falls back to the default shown here.
WEB_PORT=3001
API_PORT=4001
STORYBOOK_PORT=6006
# Host port for the Postgres container (docker-compose.yml). If you change it, change the port
# in DATABASE_URL (apps/api/.env) too.
POSTGRES_PORT=5435
# The web app's public address, for canonical links, the sitemap and social-sharing URLs.
# Set it in production (e.g. https://eats.brighte.com.au); locally it is http://localhost:$WEB_PORT.
# SITE_URL=
# How long the web server keeps the service types from the API, in seconds (default 300; 0 = no
# cache, e.g. while editing service types). Read when the web server starts.
# SERVICE_TYPES_CACHE_SECONDS=300

# Chatbot (/chat). Read when the web server starts.
# LLM providers: a provider is on when its API key is set. The model picker lists what each
# provider's models API offers, filtered by CHAT_MODELS.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Which discovered models visitors may pick: comma-separated provider:model patterns, "*" matches
# anything, a leading "!" excludes. Default: the cheap tier of each provider (a new release of it
# shows up by itself). Every message costs money, so open up pricier models deliberately.
# CHAT_MODELS=anthropic:claude-haiku-*,openai:gpt-*-mini,openai:gpt-*-nano,gemini:gemini-*-flash,gemini:gemini-*-flash-lite
# The picker's starting model, provider:model (a prefix is enough: claude-haiku-4-5 finds its dated id).
# CHAT_DEFAULT_MODEL=anthropic:claude-haiku-4-5
# How long the model list is kept before asking the providers again, in seconds.
# CHAT_MODELS_CACHE_SECONDS=3600
# Messages one visitor (IP) may send per window. In memory, per web server instance.
# CHAT_RATE_LIMIT=20
# CHAT_RATE_LIMIT_WINDOW_SECONDS=600
# Longest message a visitor may send (characters), and longest reply (tokens).
# CHAT_MAX_MESSAGE_CHARS=1000
# CHAT_MAX_OUTPUT_TOKENS=1024
# Who answers: brighte (Brighte Eats only) or general (no topic limits). See src/lib/chat/personas.ts.
# CHAT_PERSONA=brighte
